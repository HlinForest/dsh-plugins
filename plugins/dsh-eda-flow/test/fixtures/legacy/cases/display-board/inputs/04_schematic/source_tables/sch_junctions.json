  "units": {
    "units_per_mm": {
      "value": 3.937007874,
      "confidence": "low",
      "basis": "No single scale is provable from the record stream alone. Primary reading: 1 raw unit = 0.254 mm (10 mil). Basis: (a) RECORD=31 CustomX/CustomY = 1500 x 950 units then equals exactly 15.00 x 9.50 inch = 381.0 x 241.3 mm, i.e. round inch-based sheet figures; (b) 75 of 85 pins have PinLength=10 units = 100 mil, the most common Altium pin length, and 20 units = 200 mil for the rest; (c) every wire vertex and graphics coordinate is a multiple of 5 units, i.e. a 50 mil entry grid on top of the 100/200 mil component pin pitches; (d) the drawing occupies 209.6 x 118.1 mm against an 82.7 x 57.7 mm board (5.2x board area), a normal schematic-to-board ratio. See sch_extract_notes.md for the ranked alternatives (0.127 mm = 5 mil is the main one) and for the evidence that could not be resolved offline.",
      "alternatives": [
        {
          "unit_mm": 0.127,
          "units_per_mm": 7.874015748,
          "inch": "5 mil",
          "implied_sheet": "190.5 x 120.65 mm (7.50 x 4.75 in)",
          "supporting": "Symbol pin pitches then match the physical footprint pad pitches of the same components almost 1:1 (U1 SOP16 1.27 mm pitch drawn at 20 units, D1 2.54 mm part drawn at 20 units) and the designator font size 10 units becomes 1.27 mm, a typical Altium text height.",
          "against": "The whole schematic drawing (104.8 x 59.1 mm) would be only 1.3x the board area (82.7 x 57.7 mm) for 41 symbols, and the sheet would be smaller than A5, i.e. smaller than any Altium sheet preset."
        },
        {
          "unit_mm": 0.2,
          "units_per_mm": 5.0,
          "inch": "~7.87 mil",
          "implied_sheet": "300 x 190 mm",
          "supporting": "Sheet and coordinates are simultaneously round in millimetres; the 1500/6 and 950/4 border zone fields give a near-constant 50 mm zone pitch.",
          "against": "Pin length 2 mm and a 1 mm entry grid are not Altium-typical; 300 x 190 mm matches no ISO preset."
        },
        {
          "unit_mm": 0.1,
          "units_per_mm": 10.0,
          "inch": "~3.94 mil",
          "implied_sheet": "150 x 95 mm",
          "supporting": "Round millimetre sheet figures.",
          "against": "The drawing (82.5 x 46.5 mm) would be smaller than the board area covered, and pin length would be 1 mm; effectively excluded."
        }
      ],
