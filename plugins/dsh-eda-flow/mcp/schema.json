{
  "tools": [
    {
      "name": "precise_create",
      "description": "Create an empty A4 schematic in the server's fixed new-project root. No import. Idempotent request_key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "request_key": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_+.-]+$"
          },
          "title": {
            "type": "string"
          },
          "paper": {
            "enum": [
              "A4"
            ]
          },
          "portrait": {
            "type": "boolean"
          }
        },
        "required": [
          "request_key",
          "name"
        ],
        "additionalProperties": false
      }
    },
