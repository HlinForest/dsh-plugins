{
  "name": "dsh-eda-flow",
  "version": "0.4.1",
  "description": "纯文字需求与规格书驱动的 KiCad MCP 原理图流程；保留七步界面与历史工程查看",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js"
  },
  "files": [
    "src",
    "client",
    "client.js",
    "python",
    "mcp",
    "cases/display-board",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs",
    "scripts/install-intranet.ps1",
    "scripts/install-offline-python.ps1",
    "scripts/check-environment.ps1",
    "scripts/serve.mjs",
    "!**/__pycache__",
    "!**/*.pyc",
    "!python/runner.py",
    "scripts/open-window.ps1",
    "desktop",
    "scripts/install-desktop-runtime.ps1"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/service.js && node --check src/index.js && node --check client/app.js && node --check client.js",
    "start": "node scripts/serve.mjs",
    "prepack": "npm run build:messages && npm run build:client && npm run check",
    "build:client": "vite build --config frontend/vite.config.mjs",
    "build:messages": "node scripts/build-harness-messages.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "bundleDependencies": [
    "@deepseek-ai/schemastery"
  ],
  "license": "MIT",
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2",
    "@vitejs/plugin-react": "5.0.4",
    "@carbon/icons-react": "^11.90.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  }
}
