{
  "name": "dsh-engineering-workbench",
  "version": "0.6.0",
  "description": "DSH 工程工作台：独立读手册、产品方案、AD/KiCad 评审、原理图对比与向目标对齐",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./engineering": "./src/engineering/tasks.js",
    "./engineering-model": "./src/engineering/model.js",
    "./restoration": "./src/restoration/index.js"
  },
  "files": [
    "src",
    "client.js",
    "cordis.patch.yml",
    "scripts/install-engines.ps1",
    "scripts/engines.constraints.txt",
    "bridge",
    "docs",
    "README.md",
    "LICENSE",
    "examples",
    "schemas",
    "!**/__pycache__",
    "!**/*.pyc",
    "scripts/install-intranet.ps1",
    "scripts/check-environment.ps1",
    "scripts/install-offline-python.ps1",
    "web",
    "desktop",
    "scripts/install-desktop-runtime.ps1",
    "scripts/upgrade-intranet.ps1"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node --check client.js && node --check src/index.js && node --check src/service.js && node --check src/actions.js",
    "prepack": "npm run build && npm run check && npm test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "fast-xml-parser": "5.11.2"
  },
  "peerDependenciesMeta": {
    "dsh-megmeet": {
      "optional": true
    },
    "dsh-pcb-review": {
      "optional": true
    },
    "dsh-schematic-sync": {
      "optional": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "dsh-megmeet": "^0.2.1",
    "dsh-pcb-review": "^0.1.1",
    "dsh-schematic-sync": "^0.1.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "dsh-megmeet": "file:../../dist/dsh-megmeet-0.2.1.tgz",
    "dsh-pcb-review": "file:../../dist/dsh-pcb-review-0.1.2.tgz",
    "dsh-schematic-sync": "file:../../dist/dsh-schematic-sync-0.1.2.tgz",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "esbuild": "0.25.12"
  },
  "license": "MIT",
  "bundleDependencies": [
    "@deepseek-ai/schemastery",
    "fast-xml-parser"
  ]
}
