{
  "name": "dsh-pcb-review",
  "version": "0.1.2",
  "description": "AD / KiCad 原理图与 PCB 评审助手，适配 DeepSeek Harness 0.2.0-rc.2",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./engine": "./src/engine.js"
  },
  "bin": {
    "pcb-review": "src/cli.js"
  },
  "files": [
    "src",
    "examples",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo": "node src/cli.js review examples/project.kicad.json",
    "prepack": "npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "fast-xml-parser": "5.11.2",
    "csv-parse": "7.0.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2"
  },
  "license": "MIT"
}
