		(property "SelectionBasis" "现值为候选；条件计算不能唯一确定选型。"
			(at 0 0 270)
			(layer "B.SilkS")
			(hide yes)
			(uuid "267532cd-b197-4ec6-adb4-d854b44d9b10")
